# tools/amus_depart_witness.rish — the whole remove-a-member lifecycle, closed: a voter is removed by joint consensus, and a leader
# that removes itself steps down (AMUS28).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark AMUS · rung
# AMUS28. Design read: active-designing/20260814-080327_amus28-constel-depart-remove-member.md
#
# constel/depart.rye is the symmetric twin of AMUS26 (admit): where admit promoted a caught-up learner through joint consensus,
# depart removes a voter through the same no-fork switch, and names the one edge that makes removal harder than addition — a LEADER
# that removes ITSELF (Raft §4.2.2). The selftest proves: removing a non-voter is refused (NotAVoter); removing the last voter is
# refused (EmptyConfig); a voter is removed (old 4 → new 3) and the remaining piers carry the switch without the leaver's vote; the
# leader-removes-itself edge — leader_relinquishes fires, the leader votes in the old side yet the new majority comes from the
# remaining piers alone; neither an old-only nor a new-only quorum can smuggle the removal (NoJointMajority); bounded eight → seven.
# Purely local — no socket, no network, no keys, no funds, no real address.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/amus_depart_witness.rish

say "amus-depart: Language EN — AMUS28 closes the remove-a-member lifecycle: a voter leaves the sky through reconfig's joint consensus (AMUS13), and when the leaving pier is the leader it steps down after the switch commits (AMUS24 CheckQuorum) — the symmetric twin of AMUS26's add side."
say "amus-depart: Style Radiant — a pier may leave the sky whole, and the leader that removes itself steps down as gracefully as it once rose; the circle it leaves and the circle that remains must both agree, so no member is ever dropped over its own head."
say "amus-depart: Lens TAME — depart refuses NotAVoter and (via config_of) EmptyConfig, then composes reconfig.config_of / JointConfig / JointBallot / require_joint over public APIs only; leader_relinquishes makes the Raft §4.2.2 self-removal edge checkable; the joint ballot's two-majority rule carries the AMUS9 intersection lemma across the switch unchanged; bounded to roster.max_piers; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/depart"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/depart.rye -femit-bin=${bin}"]
assert build.ok else "amus-depart: build failed — ${build.err}"

let outfile = "constel/bin/depart.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "amus-depart: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "amus-depart: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN amus-depart' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "amus-depart: selftest did not print the GREEN amus-depart line"

say "amus-depart: GREEN — the whole remove-a-member lifecycle is proven pure on the bench: a voter leaves by joint consensus and a leader that removes itself steps down, a member removed exactly the safe way."
