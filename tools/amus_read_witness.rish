# tools/amus_read_witness.rish — a linearizable read that appends nothing, the read-index (AMUS20).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark AMUS · rung
# AMUS20. Design read: active-designing/20260814-084100_amus20-constel-read-index-linearizable-reads.md
#
# constel/read.rye completes the linearizable service AMUS19 began: exactly-once writes, and now linearizable READS without a
# log append (Raft §8, the read-index). A deposed leader that still believes it leads must not answer a read from its stale
# state; the read-index refuses it at the root — confirm a majority still holds the leader's term (AMUS16's lemma), capture the
# commit index (AMUS18's safe_commit_len), apply the state machine through it (AMUS19's apply_through), then answer. The selftest
# proves: a read reflects every write committed before it; the read-index IS the commit index (derived by safe_commit_len over a
# real TermedLog); a stale leader serves nothing (NotLeader when a majority has moved on); monotonic reads (the value only
# climbs); a read appends nothing and is idempotent; and it runs bounded. Purely local — no socket, no network, no keys, no
# funds, no real client, no real address ever formed.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/amus_read_witness.rish

say "amus-read: Language EN — AMUS20 completes the linearizable service: exactly-once writes (AMUS19) and now linearizable reads WITHOUT a log append (Raft §8, the read-index). A deposed leader answers for nothing; a current leader answers a value reflecting every write committed before the read."
say "amus-read: Style Radiant — every read a keeper takes is true as of the moment they asked, and a leader the sky has left behind answers for nothing at all."
say "amus-read: Lens TAME — leadership_confirmed spends AMUS16's term-majority lemma; the read-index is AMUS18's safe_commit_len; the read folds AMUS19's committed prefix and appends nothing; NotLeader and ReadIndexPastLog refuse by name changing nothing; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real client, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/read"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/read.rye -femit-bin=${bin}"]
assert build.ok else "amus-read: build failed — ${build.err}"

let outfile = "constel/bin/read.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "amus-read: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "amus-read: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN amus-read' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "amus-read: selftest did not print the GREEN amus-read line"

say "amus-read: GREEN — a linearizable read appends nothing; the constel consensus track now serves reads as of the moment they were asked, the deposed-leader stale read refused at its root, proven pure on the bench."
