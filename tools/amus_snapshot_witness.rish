# tools/amus_snapshot_witness.rish — compact the log so it can serve forever (AMUS14).
#
# Season: the Six-Season double-seat, Season D thread (Kresfa & Mycelium — the tree's own consensus) · waymark AMUS · rung
# AMUS14. Design read: active-designing/20260814-060326_amus14-constel-snapshot-log-compaction.md
# Law kin: .claude/rules/placeholder-ship-names.md — the border guards every accept: a decree's replies deframe at the
# naming-law border (wire.deframe), so a real address can never enter a compacted log even as an accept.
#
# constel/snapshot.rye lets AMUS12's bounded append-only log serve an unbounded history by folding its committed prefix into a
# compact snapshot and reclaiming the room. The fold is deterministic and order-sensitive, so two piers that committed the same
# prefix hold identical snapshots — the no-fork guarantee carries into compaction. A CompactLog keeps a snapshot plus a live
# tail; compact folds the tail into the snapshot and empties it, so the effective log grows past the tail bound in bounded
# memory. The selftest proves: the fold is order-sensitive; append/get/TailFull on the tail; compact preserves total() and
# effective_state() and turns a folded index into Compacted; no fork across differing compaction schedules; compaction carries
# the effective log past max_tail; a real sky commits a sequence past the tail cap, a failed decree leaving the log untouched.
# Purely local — no socket, no network, no keys, no funds, no real address ever formed.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/amus_snapshot_witness.rish

say "amus-snapshot: Language EN — AMUS14 compacts AMUS12's log: a deterministic, order-sensitive fold folds the committed prefix into a snapshot and reclaims the room, so a bounded log serves an unbounded history and — because two piers folding the same committed prefix reach the same snapshot — never forks across the compaction."
say "amus-snapshot: Style Radiant — a log that could hold only sixty-four decisions now folds its settled history into a single summary and keeps writing; the one-value-per-index law and the missing vowel carry the no-fork guarantee straight through the fold."
say "amus-snapshot: Lens TAME — the tail is bounded (TailFull at max_tail) and append-only; compact does bounded work and preserves the effective length and state; a failed decree leaves the log unchanged; siloed to constel/, run from inside the jailed pier; no socket, no network, no keys, no funds, no real address ever formed (custody gate #2 and gate #4 untouched)."

let zig = "vendor/zig-toolchain/zig"
let bin = "constel/bin/snapshot"

let build = run ["sh" "-c" "mkdir -p constel/bin && env RYE_ZIG=${zig} rye/bin/rye build constel/snapshot.rye -femit-bin=${bin}"]
assert build.ok else "amus-snapshot: build failed — ${build.err}"

let outfile = "constel/bin/snapshot.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "amus-snapshot: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "amus-snapshot: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN amus-snapshot' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "amus-snapshot: selftest did not print the GREEN amus-snapshot line"

say "amus-snapshot: GREEN — the log compacts and serves on; the constel consensus track now produces a ledger that runs past its own bound without a fork, proven pure on the bench."
