# tools/caum_verify_witness.rish — the desk fsck: prove the integrity of everything it holds (CAUM16).
#
# Season A (Hardware & Right-to-Repair) · waymark CAUM · Mikrophone firmware journey · rung CAUM16.
# Design read: active-designing/20260814-073400_caum16-desk-verify-fsck-prove-what-it-holds-exploration.md
# Stands on: mikrophone/catalog.rye (CAUM7) — the content-addressed store and the one address_of rule.
#
# mikrophone/verify.rye is the desk's fsck: verify walks every held recording, re-derives its content address from the
# bytes the store holds now, and asserts it still equals the address it was keyed under — refusing IntegrityFault by name
# the moment a stored byte has drifted. The selftest proves: a whole desk verifies sound (read-only, count untouched), an
# empty desk verifies trivially, a re-deposit stays sound, and a single flipped store byte refuses IntegrityFault — then
# flips back to sound, proof the check tracks the bytes and not a latched flag.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/caum_verify_witness.rish

say "caum-verify: Language EN — CAUM16 lets the desk prove the trust it keeps; verify re-derives every stored recording's content address and refuses IntegrityFault the moment a byte has drifted."
say "caum-verify: Style Radiant — the desk that keeps by content learns to prove what it keeps, re-deriving every address from the bytes it actually holds so soundness is shown, not merely declared."
say "caum-verify: Lens TAME — verify is read-only over the public API, bounded by the count, re-hashing through the one address_of rule the deposit keyed by, refusing IntegrityFault by name; the content address is an integrity identity, not a signature; no disk, no network, no key, no funds."

let zig = "vendor/zig-toolchain/zig"
let bin = "mikrophone/bin/verify"

let build = run ["sh" "-c" "mkdir -p mikrophone/bin && env RYE_ZIG=${zig} rye/bin/rye build mikrophone/verify.rye -femit-bin=${bin}"]
assert build.ok else "caum-verify: build failed — ${build.err}"

let outfile = "mikrophone/bin/verify.out"
let selftest = run ["sh" "-c" "${bin} selftest > ${outfile} 2>&1"]
assert selftest.ok else "caum-verify: selftest exited non-zero — see ${outfile}"

let shown = run ["sh" "-c" "cat ${outfile}"]
say "caum-verify: ${shown.out}"

let green = run ["sh" "-c" "grep -q 'GREEN caum-verify' ${outfile} && echo yes"]
assert (trim green.out) == "yes" else "caum-verify: selftest did not print the GREEN caum-verify line"

say "caum-verify: GREEN — the Mikrophone desk proves the integrity of everything it holds, the fsck. CAUM16 catches silent store corruption by name, read-only; proving over a real disk or transport stays the maintainer's gate."
