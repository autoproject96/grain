# tools/gen/oven/oven_corpus_lap4.rish — Oven corpus lap 2 path_suffix filter witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gen/oven/oven_corpus_lap4.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "oven/bin/oven"

let build = run ["sh" "-c" "mkdir -p oven/bin && env RYE_ZIG=${zig} rye/bin/rye build oven/oven.rye -femit-bin=${bin}"]
assert build.ok else "Oven corpus lap 4 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Oven selftest exited non-zero"
assert selftest.out contains "GREEN" else "Oven selftest not GREEN"
assert selftest.out contains "path_suffix filter" else "Oven missing path_suffix welcome"

say "GREEN: Oven corpus lap 4 — path_suffix filter on corpus query."
