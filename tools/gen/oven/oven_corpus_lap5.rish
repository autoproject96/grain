# tools/gen/oven/oven_corpus_lap5.rish — Oven corpus lap 2 sum_lines fold witness.
#
# Run from the repository root:
#   rishi/bin/rishi run tools/gen/oven/oven_corpus_lap5.rish

let zig = "vendor/zig-toolchain/zig"
let bin = "oven/bin/oven"

let build = run ["sh" "-c" "mkdir -p oven/bin && env RYE_ZIG=${zig} rye/bin/rye build oven/oven.rye -femit-bin=${bin}"]
assert build.ok else "Oven corpus lap 5 build failed"

let selftest = run ["sh" "-c" "${bin} selftest 2>&1"]
assert selftest.ok else "Oven selftest exited non-zero"
assert selftest.out contains "GREEN" else "Oven selftest not GREEN"
assert selftest.out contains "sum_lines fold" else "Oven missing sum_lines welcome"

say "GREEN: Oven corpus lap 5 — sum_lines fold over matching chunks."
