# tools/gen/season/oven_season_o0_witness.rish — Oven Season o0 seat.
#
#   rishi/bin/rishi run tools/gen/season/oven_season_o0_witness.rish

say "oven-season-o0: Language EN — pause Surface; open Oven oct."
say "oven-season-o0: Style Radiant — seat the nest; refuse silent path cut."
say "oven-season-o0: Lens TAME — Oven Season o0."

let charter = run ["test" "-f" "counsel/20260728-234419_the-oven-season-oct-charter.md"]
assert charter.ok else "oven-season-o0: oct charter missing"
let bow = run ["test" "-f" "counsel/20260728-234419_oven-season-o0-bow-surface-paused.md"]
assert bow.ok else "oven-season-o0: o0 bow missing"
let prompt = run ["test" "-f" "expanding-prompts/20260728-234419_oven-season-o0-recursion-prompt.md"]
assert prompt.ok else "oven-season-o0: recursion printout missing"

let pins = run ["sh" "-c" "grep -q 'PAUSED' counsel/20260728-234419_the-oven-season-oct-charter.md && grep -q 'return_surface_p39' counsel/20260728-234419_the-oven-season-oct-charter.md && grep -q 'o0 complete' counsel/20260728-234419_the-oven-season-oct-charter.md && grep -q 'oct' context/LEXICON.md && grep -q 'The Oven Season' context/LEXICON.md && echo O0_OK"]
assert pins.ok else "oven-season-o0: seat pin scan failed"
assert pins.out contains "O0_OK" else "oven-season-o0: oct lexicon or handback not seated"

let held = run ["sh" "-c" "test -d anvil && echo ANVIL_HELD"]
assert held.ok else "oven-season-o0: anvil/ must still exist at o0"
assert held.out contains "ANVIL_HELD" else "oven-season-o0: do not cut at o0"

let scope = run ["sh" "-c" "grep -q 'oct:   Oven Season — OPEN' tools/gen/season/prin_scope.rish && grep -q 'sept:   Surface Season — PAUSED' tools/gen/season/prin_scope.rish && echo SCOPE_OK"]
assert scope.ok else "oven-season-o0: prin_scope pin scan failed"
assert scope.out contains "SCOPE_OK" else "oven-season-o0: prin_scope not eight-nest"

say "GREEN: oven-season-o0 — oct OPEN · Surface PAUSED · anvil/ held · Oven Season"
say "GREEN: oven-season-o0 — cut waits o1 word."
