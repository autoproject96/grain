# tools/oven_corpus_lap3.rish — shim → tools/gen/oven/oven_corpus_lap3.rish (Oven Season o1)
if length args == 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/oven/oven_corpus_lap3.rish"]
if length args != 0 then let r = run ["rishi/bin/rishi" "run" "tools/gen/oven/oven_corpus_lap3.rish" args[0]]
if r.out != "" then say r.out
exit r.code
